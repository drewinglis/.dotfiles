#!/usr/bin/env bash
# Export the Wayland session environment to systemd --user and D-Bus, then bring
# up graphical-session.target. On Debian/systemd this replaces greglook's
# `openrc --user desktop`.
#
# waybar, mako, hyprpaper, hypridle and hyprpolkitagent all ship user units that
# are WantedBy=graphical-session.target and carry Restart=on-failure. Starting
# the target runs them supervised, so a crashed daemon comes back on its own -
# which bare `exec-once` lines do not give you.

vars=(DISPLAY WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP)

dbus-update-activation-environment --systemd "${vars[@]}" 2>/dev/null
systemctl --user import-environment "${vars[@]}" 2>/dev/null

systemctl --user start hyprland-session.target 2>/dev/null

# Portals are D-Bus activated; give them a clean start under the new env.
systemctl --user restart xdg-desktop-portal-hyprland.service 2>/dev/null
sleep 1
systemctl --user restart xdg-desktop-portal.service 2>/dev/null
