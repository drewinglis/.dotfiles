#!/bin/bash
#
# Prints the tmux window name for a pane: "repo:branch" inside a git
# repository (including worktrees, where the name is the main repo's), and
# the pane's command otherwise.

readonly TARGET_PWD="${1}"
readonly PANE_COMMAND="${2}"
readonly GIT_BRANCH_MAX_LENGTH=50
readonly WINDOW_NAME_MAX_LENGTH=100

# Use local override if applicable.
readonly LOCAL_OVERRIDE_SCRIPT="$HOME/local.conf.d/bin/tmux-window-name"

if [[ -x ${LOCAL_OVERRIDE_SCRIPT} ]]; then
  local_override="$(${LOCAL_OVERRIDE_SCRIPT} "${TARGET_PWD}" "${PANE_COMMAND}")"
  if [[ -n ${local_override} ]]; then
    echo "${local_override}"
    exit 0
  fi
fi

if [[ ! -d ${TARGET_PWD} ]]; then
  echo "${TARGET_PWD:0:${WINDOW_NAME_MAX_LENGTH}}"
  exit 0
fi

# One git call yields both the repository we're in (--git-common-dir points at
# the main repository even from a worktree) and the branch ("HEAD" when
# detached).
if git_info=$(git -C "${TARGET_PWD}" rev-parse --path-format=absolute \
    --git-common-dir --abbrev-ref HEAD 2>/dev/null); then
  git_dir="${git_info%$'\n'*}"
  branch="${git_info##*$'\n'}"

  # Name the repository after the directory containing .git, or after the
  # directory itself for a bare repository.
  repo="${git_dir%/.git}"
  repo="${repo##*/}"
  # Strip leading punctuation, so ~/.dotfiles shows up as "dotfiles".
  repo="${repo#"${repo%%[a-zA-Z0-9]*}"}"

  [[ ${branch} == HEAD ]] && branch='(detached)'

  echo "${repo}:${branch:0:${GIT_BRANCH_MAX_LENGTH}}"
  exit 0
fi

echo "${PANE_COMMAND:0:${WINDOW_NAME_MAX_LENGTH}}"
